[Unit]
Description=Hermes RDP API and Telegram dashboard
After=network-online.target hermes-rdp-sshd.service
Wants=network-online.target hermes-rdp-sshd.service

[Service]
Type=simple
User=hermes-rdp
Group=hermes-rdp
Environment=PYTHONPATH=/opt/hermes-rdp/app
ExecStart=/usr/bin/python3 -m hermes_rdp.service
Restart=always
RestartSec=5
UMask=0027
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/hermes-rdp
ReadWritePaths=-/etc/letsencrypt
ReadWritePaths=-/var/lib/letsencrypt
ReadWritePaths=-/var/log/letsencrypt
ReadWritePaths=-/var/www/hermes-rdp-acme
ReadWritePaths=-/etc/nginx/conf.d
ReadWritePaths=-/etc/nginx/sites-enabled
ReadWritePaths=-/var/lib/headscale
ReadWritePaths=-/var/run/headscale
ReadOnlyPaths=/etc/hermes-rdp

[Install]
WantedBy=multi-user.target
